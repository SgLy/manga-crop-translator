root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
ktlint_code_style = ktlint_official
max_line_length = 140
# Compose composables are PascalCase by convention, so ktlint's function-naming rule must not
# rename them.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.bat]
end_of_line = crlf
